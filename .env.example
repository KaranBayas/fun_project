# ==============================================================================
# SECURE DIGITAL DMS (SIH 2026) — AI SERVICES API — ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Services API — Unified Authentication Key
# Used by Spring Boot backend as X-API-Key header.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# ------------------------------------------------------------------------------
AI_SERVICES_API_KEY=your-ai-services-api-key-here

# ------------------------------------------------------------------------------
# Face Recognition — Fernet Encryption Key for face embedding storage
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: Do NOT change this key after faces have been registered.
# Changing it will make all existing encrypted face data unreadable.
# ------------------------------------------------------------------------------
FACE_ENCRYPTION_KEY=your-fernet-32-byte-base64-key-here

# ------------------------------------------------------------------------------
# Face Recognition — Optional settings
# ------------------------------------------------------------------------------
FACE_DATABASE_PATH=face_recognition/face_data/face_database.json
FACE_MAX_UPLOAD_SIZE_MB=5
FACE_SIMILARITY_THRESHOLD=0.5

# ------------------------------------------------------------------------------
# Semantic Search — Qdrant vector database
# ------------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=document_chunks

# ------------------------------------------------------------------------------
# Semantic Search — BGE-M3 embedding model
# ------------------------------------------------------------------------------
MODEL_NAME=BAAI/bge-m3
VECTOR_DIMENSION=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_TOP_K=10
MAX_FILE_SIZE_MB=20
ALLOWED_FILE_EXTENSIONS=.pdf,.docx,.doc,.txt,.csv,.xlsx,.pptx,.jpg,.jpeg,.png,.webp,.tif,.tiff

# ------------------------------------------------------------------------------
# CORS — comma-separated allowed origins (leave empty to disable CORS)
# Example: http://localhost:3000,http://localhost:8080
# ------------------------------------------------------------------------------
CORS_ORIGINS=
